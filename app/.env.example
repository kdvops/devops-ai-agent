# Copy this file to .env and replace the key locally. Never commit .env.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.5
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_USERNAME=x-access-token
GIT_COMMIT_NAME=DevOps AI Agent
GIT_COMMIT_EMAIL=devops-ai-agent@local.invalid
# Configure only one password source; PAT/API key/password are used as the HTTPS password.
GIT_TOKEN=
GIT_PAT=
GIT_API_KEY=
GIT_PASSWORD=
EXTERNAL_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1
SSH_ALLOWED_HOSTS=
SSH_ALLOWED_COMMANDS=uname,uptime,hostname,whoami,df,free,systemctl status,docker ps,kubectl get,kubectl describe
SSH_USERNAME=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=true
